# Copy this file to .env and fill in your values

# Groq API Key (https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use for explanations (fast and capable)
GROQ_MODEL=llama-3.3-70b-versatile

# SQLite database path (relative to backend/)
DATABASE_URL=sqlite:///./pathgen.db

# Max paths to enumerate per CFG (prevents explosion)
MAX_PATHS=50

# Max loop iterations when unrolling loops
MAX_LOOP_ITERATIONS=3
